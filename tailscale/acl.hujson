// Canonical copy lives next to the runbook:
//   ../cloudflare/tailscale-acl.hujson
// Keep these two files identical.

{
  "tagOwners": {
    "tag:node": ["autogroup:admin"],
    "tag:app":  ["autogroup:admin"],
    "tag:db":   ["autogroup:admin"],
    "tag:ci":   ["autogroup:admin"],
  },

  "autoApprovers": {
    "tags": {
      "tag:node": ["tag:node"],
      "tag:app":  ["tag:app"],
      "tag:db":   ["tag:db"],
      "tag:ci":   ["tag:ci"],
    },
  },

  "groups": {
    "group:ops": [
      "github_user:REPLACE_OPS_LEAD",
      "github_user:REPLACE_SRE",
    ],
    "group:dev": [
      "github_user:REPLACE_DEVELOPER",
    ],
  },

  "grants": [
    {
      "src": ["group:ops"],
      "dst": ["tag:node"],
      "ip":  ["22", "6443", "3000", "9090", "3100"],
    },
    {
      "src": ["tag:ci"],
      "dst": ["tag:node"],
      "ip":  ["22"],
    },
    {
      "src": ["tag:app"],
      "dst": ["tag:db"],
      "ip":  ["5432", "3306"],
    },
    {
      "src": ["tag:node"],
      "dst": ["tag:node"],
      "ip":  ["6443", "10250", "8472", "51820"],
    },
    {
      "src": ["tag:node"],
      "dst": ["tag:db"],
      "ip":  ["5432", "3306"],
    },
    {
      "src": ["autogroup:member"],
      "dst": ["autogroup:self"],
      "ip":  ["*"],
    },
  ],

  "ssh": [
    {
      "action": "accept",
      "src":    ["group:ops"],
      "dst":    ["tag:node"],
      "users":  ["ubuntu", "autogroup:nonroot"],
    },
    {
      "action": "accept",
      "src":    ["tag:ci"],
      "dst":    ["tag:node"],
      "users":  ["ubuntu"],
    },
    {
      "action": "check",
      "src":    ["group:ops"],
      "dst":    ["tag:node"],
      "users":  ["root"],
    },
  ],

  "disableIPv4":   false,
  "oneCGNATRoute": false,
}
