# Copy to .env (gitignored). Never commit real tokens.

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-now

# From Cloudflare Zero Trust → Networks → Tunnels → token.
# Leave empty to run compose without the tunnel profile.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: GHCR image pin used by CI.
APP_IMAGE=ghcr.io/example/edge-echo
APP_TAG=dev
