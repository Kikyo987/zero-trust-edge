[Unit]
Description=Cloudflare Tunnel (outbound-only origin connector)
Documentation=https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/
After=network-online.target
Wants=network-online.target
# Fail closed if the token is missing. Do not start a listener instead.
ConditionPathExists=/etc/edge/cloudflared.token

[Service]
Type=simple
User=cloudflared
Group=cloudflared
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate --config /etc/cloudflared/config.yml run --token-file /etc/edge/cloudflared.token
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
LockPersonality=true
MemoryMax=128M
CPUQuota=25%
# No extra capabilities. cloudflared does not need NET_BIND_SERVICE;
# it does not listen on :443.

[Install]
WantedBy=multi-user.target
